# Run the unit tests of the shared packages with the race detector, and
# write their coverage to coverage/ at the root of the repository.
test:
    mkdir -p ../coverage
    go test -race -coverpkg=github.com/tidegate-dev/tidegate/... -coverprofile=../coverage/internal.out ./...

# Lint the shared packages.
lint:
    golangci-lint run ./...

# Format the shared packages' code in place.
fmt:
    golangci-lint fmt ./...

# Check the shared packages' dependencies for known vulnerabilities.
vuln:
    govulncheck ./...

# Run every check that CI runs on the shared packages.
ci: test lint vuln
