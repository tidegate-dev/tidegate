# Build the control plane into bin/ at the root of the repository.
build:
    go build -o ../bin/control-plane ./cmd/control-plane

# Build the control plane's container image with podman or Docker.
image:
    #!/usr/bin/env sh
    set -eu
    runtime=$(command -v podman || command -v docker) || {
        echo "Install podman or Docker to build the image." >&2
        exit 1
    }
    "$runtime" build --file Containerfile --tag localhost/tidegate-control-plane ..

# Run the control plane's unit tests.
test:
    go test ./...

# Lint the control plane.
lint:
    golangci-lint run ./...

# Format the control plane's code in place.
fmt:
    golangci-lint fmt ./...

# Check the control plane's dependencies for known vulnerabilities.
vuln:
    govulncheck ./...

# Run every check that CI runs on the control plane.
ci: build test lint vuln image
