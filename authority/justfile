import 'test-database.just'

# Build the authority into bin/ at the root of the repository.
build:
    go build -o ../bin/authority ./cmd/authority

# Build the authority's container image with podman or Docker.
image:
    #!/usr/bin/env sh
    set -eu
    runtime=$(command -v podman || command -v docker) || {
        echo "Install podman or Docker to build the image." >&2
        exit 1
    }
    "$runtime" build --file Containerfile --tag localhost/tidegate-authority ..

# Run the authority's unit tests with the race detector, and write their
# coverage to coverage/ at the root of the repository.
test:
    mkdir -p ../coverage
    go test -race -coverpkg=github.com/tidegate-dev/tidegate/... -coverprofile=../coverage/authority.out ./...

# Run the authority's integration tests with the race detector, and write
# their coverage to coverage/ at the root of the repository.
test-integration:
    mkdir -p ../coverage
    go test -race -tags integration -coverpkg=github.com/tidegate-dev/tidegate/... -coverprofile=../coverage/authority-integration.out ./...

# Create a database on the test Postgres server, start the authority against
# it, run the API tests in api-tests/ against the authority, drop the database
# and write the authority's coverage to coverage/ at the root of the
# repository. Like the integration tests, they need Postgres.
test-api:
    #!/usr/bin/env bash
    set -euo pipefail
    ../dev/tls-setup.sh
    mkdir -p ../coverage
    server=${TIDEGATE_TEST_DATABASE_URL%%\?*}
    query=${TIDEGATE_TEST_DATABASE_URL#"$server"}
    # libpq lets these replace the database in the path.
    case $query in *dbname=* | *database=*)
        echo "TIDEGATE_TEST_DATABASE_URL must not name a database in its query." >&2
        exit 1
        ;;
    esac
    case ${server#*://} in */*) server=${server%/*} ;; esac
    database=test_api_$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')
    psql=(psql --quiet --no-psqlrc --set ON_ERROR_STOP=1 "$TIDEGATE_TEST_DATABASE_URL")
    "${psql[@]}" --command "CREATE DATABASE $database"
    work=$(mktemp -d)
    authority=
    cleanup() {
        if [ -n "$authority" ]; then
            kill "$authority" 2>/dev/null || true
            wait "$authority" 2>/dev/null || true
        fi
        rm -rf "$work"
        "${psql[@]}" --command "DROP DATABASE $database WITH (FORCE)"
    }
    trap cleanup EXIT
    mkdir "$work/coverage"
    go build -cover -coverpkg=github.com/tidegate-dev/tidegate/... -o "$work/authority" ./cmd/authority
    # Other ports than just dev, so both can run at the same time.
    GOCOVERDIR="$work/coverage" \
    TIDEGATE_AUTHORITY__SERVER__LISTEN_ADDRESS=127.0.0.1:18080 \
    TIDEGATE_AUTHORITY__METRICS__LISTEN_ADDRESS=127.0.0.1:19464 \
    TIDEGATE_AUTHORITY__SERVER__TLS__CERT_FILE=../dev/tls/authority.pem \
    TIDEGATE_AUTHORITY__SERVER__TLS__KEY_FILE=../dev/tls/authority-key.pem \
    TIDEGATE_AUTHORITY__DATABASE__URL="$server/$database$query" \
    TIDEGATE_AUTHORITY__DATABASE__MIGRATE_ON_START=true \
        "$work/authority" >"$work/log" 2>&1 &
    authority=$!
    options=(--cacert ../dev/tls/ca.pem --variable authority=https://127.0.0.1:18080)
    if ! hurl "${options[@]}" --retry 50 --retry-interval 200 api-tests/ping.hurl >/dev/null; then
        cat "$work/log" >&2
        exit 1
    fi
    hurl --test "${options[@]}" api-tests/*.hurl
    # The authority writes its coverage only when it stops cleanly.
    kill "$authority"
    stopped=$authority
    authority=
    if ! wait "$stopped"; then
        cat "$work/log" >&2
        exit 1
    fi
    go tool covdata textfmt -i="$work/coverage" -o ../coverage/authority-api.out

# Lint the authority.
lint:
    golangci-lint run ./...

# Format the authority's code in place.
fmt:
    golangci-lint fmt ./...

# Check the authority's dependencies for known vulnerabilities.
vuln:
    govulncheck ./...

# Generate the Go code for the SQL queries in internal/db/queries/.
generate:
    sqlc generate

# Fail if the generated code doesn't match the SQL queries.
check-generated:
    sqlc diff

# Run every check that CI runs on the authority.
ci: build test test-integration test-api lint vuln check-generated image
