# The build stage runs on the platform of the machine that builds the image,
# and Go cross-compiles for the target platform. A multi-platform build then
# doesn't run the compiler in an emulator.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.4@sha256:08bcb99a38f85a265f9a93d1d3323e2440eec333380f3ea26ee0dec9264bb41c AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS TARGETARCH
# In a git worktree, .git points outside the build context, and stamping
# VCS information into the binary fails.
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -buildvcs=false -o /authority ./authority/cmd/authority

FROM gcr.io/distroless/static:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5

COPY --from=build /authority /authority
ENV PHEMERA_AUTHORITY__EXTERNAL_API__LISTEN_ADDRESS=:8080 \
    PHEMERA_AUTHORITY__METRICS__LISTEN_ADDRESS=:9464
EXPOSE 8080 9464
ENTRYPOINT ["/authority"]
