FROM docker.io/library/golang:1.27.3@sha256:9048d5e7751706200eb1719c7dae0436950d362f29a1da91fa05e5c63867c60f AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# In a git worktree, .git points outside the build context, and stamping
# VCS information into the binary fails.
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /authority ./authority/cmd/authority

FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329

COPY --from=build /authority /authority
ENV TIDEGATE_AUTHORITY__SERVER__LISTEN_ADDRESS=:8080 \
    TIDEGATE_AUTHORITY__METRICS__LISTEN_ADDRESS=:9464
EXPOSE 8080 9464
ENTRYPOINT ["/authority"]
