# Generate the Go code for the .proto files into gen/ and the API reference into
# docs/content/reference/, both at the root of the repository.
generate:
    buf generate

# Lint the .proto files.
lint:
    buf lint

# Fail if the generated code doesn't match the .proto files.
check-generated: generate
    git diff --exit-code -- ../gen ../docs/content/reference
    test -z "$(git ls-files --others --exclude-standard -- ../gen ../docs/content/reference)"

# Run every check that CI runs on the .proto files.
ci: lint check-generated
