# Build the CLI into bin/ at the root of the repository.
build:
    go build -o ../bin/ ./cmd/tidegate

# Run the CLI's unit tests with the race detector, and write their coverage
# to coverage/ at the root of the repository.
test:
    mkdir -p ../coverage
    go test -race -coverpkg=github.com/tidegate-dev/tidegate/... -coverprofile=../coverage/cli.out ./...

# Lint the CLI.
lint:
    golangci-lint run ./...

# Format the CLI's code in place.
fmt:
    golangci-lint fmt ./...

# Check the CLI's dependencies for known vulnerabilities.
vuln:
    govulncheck ./...

# Run every check that CI runs on the CLI.
ci: build test lint vuln
